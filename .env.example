# ---------------------------------------------------------------------------
# LLM backend selection
# ---------------------------------------------------------------------------
# Which LLM to use for translation / narration / summary / command extraction.
# Default: ollama  (local, no API cost)
# Other:   anthropic  (uses Claude API; requires ANTHROPIC_API_KEY)
EJUTUBE_LLM_BACKEND=ollama

# ---------------------------------------------------------------------------
# Ollama (default backend) — runs locally, zero token cost
# ---------------------------------------------------------------------------
OLLAMA_ENDPOINT=http://127.0.0.1:11434
# gemma4:e4b (8B Q4) is the recommended quality/speed tradeoff.
# Use gemma4:e2b (5B) if e4b is too slow on your hardware.
OLLAMA_MODEL=gemma4:e4b

# ---------------------------------------------------------------------------
# Anthropic Claude API (only when EJUTUBE_LLM_BACKEND=anthropic)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# VOICEVOX (TTS)
# ---------------------------------------------------------------------------
VOICEVOX_ENDPOINT=http://127.0.0.1:50021

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
OUTPUT_DIR=./output

# ---------------------------------------------------------------------------
# TTS voice presets (--voice オプションで指定)
# ---------------------------------------------------------------------------
# yt-ja tts VIDEO_ID --voice tsumugi   # デフォルト: 春日部つむぎ (id=8)
# yt-ja tts VIDEO_ID --voice zundamon  # ずんだもん (id=3)
# yt-ja tts VIDEO_ID --voice metan     # 四国めたん (id=2)
#
# power-user: speaker ID を直接指定する場合 (--voice より優先)
# yt-ja tts VIDEO_ID --speaker 8
